// GlowUpp database schema
// See docs/BACKEND_ARCHITECTURE.md for the reasoning behind these choices.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  HOMEOWNER
  PROFESSIONAL
  ADMIN
}

// `id` intentionally has no default — it must always be set explicitly to
// match the corresponding Supabase `auth.users.id`. Auth (Phase 2) creates
// this row right after signup; Prisma never generates this id itself.
model User {
  id        String   @id @db.Uuid
  role      UserRole
  name      String
  email     String   @unique
  phone     String?
  postcode  String?
  // True for a placeholder row auto-created the first time an anonymous
  // visitor uses the redesign wizard (src/lib/guest.ts) — lets a guest
  // upload photos and generate designs before creating a real account.
  // Merged into the real account on signup/login (src/lib/actions/auth.ts)
  // and never granted access to anything beyond their own project(s).
  isGuest   Boolean  @default(false) @map("is_guest")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects          Project[]      @relation("HomeownerProjects")
  quoteRequestsSent QuoteRequest[] @relation("HomeownerQuoteRequests")
  professional      Professional?
  activity          ActivityLog[]  @relation("ActivityActor")
  messagesSent      Message[]
  privatePipelineSessions PrivatePipelineSession[]
  affiliatePayoutsMade    AffiliatePayout[] @relation("AffiliatePayoutAdmin")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  COLLECTING_INFORMATION
  DESIGNING
  DESIGN_READY
  REQUESTING_QUOTES
  QUOTES_RECEIVED
  PROFESSIONAL_SELECTED
  COMPLETED
  CANCELLED
}

// `projectType` is a plain string, not a Postgres enum, and validated at
// the application layer against the registry in `src/lib/project-types.ts`.
// This is the mechanism that lets us add "Loft conversion" or "Extension"
// later without a schema migration — only a new registry entry (and its
// question set) is needed. See docs/BACKEND_ARCHITECTURE.md §4.
model Project {
  id              String        @id @default(uuid()) @db.Uuid
  homeownerId     String        @map("homeowner_id") @db.Uuid
  homeowner       User          @relation("HomeownerProjects", fields: [homeownerId], references: [id], onDelete: Cascade)
  projectType     String        @map("project_type")
  title           String
  description     String?       @db.Text
  postcode        String
  // Budget stored in minor currency units (pence) to avoid floating-point
  // rounding errors. £15,000 is stored as 1500000.
  budgetMin       Int?          @map("budget_min")
  budgetMax       Int?          @map("budget_max")
  targetStartDate DateTime?     @map("target_start_date") @db.Date
  status          ProjectStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  // Set once the "you have quotes waiting" reminder email has been sent
  // for this project (src/lib/reminders.ts) — prevents sending it more
  // than once. Null until then.
  quoteReminderSentAt DateTime? @map("quote_reminder_sent_at")
  // True when the project was started through a contractor's referral
  // link/QR code (src/lib/data/private-pipeline.ts). Such a project is
  // locked to that one professional and must never reach the open
  // marketplace — checked server-side in pushToOpenMarket,
  // submitOpenMarketQuote and getOpenMarketProjects, not just hidden in
  // the UI. Always set together with a PrivatePipelineSession row.
  isPrivatePipeline   Boolean       @default(false) @map("is_private_pipeline")
  // B2B Affiliate & Partner Program (src/lib/data/affiliates.ts): the
  // partner whose link/QR brought this homeowner in, stamped when the
  // project is created — NOT read from a cookie at payment time, because
  // the Stripe webhook that clears a fee has no browser cookies. The
  // payout is the partner's share of the lead fee GlowUpp actually
  // collected (pence), set once when the fee is PAID and cleared if the
  // fee is later un-paid. Null until then.
  affiliatePartnerId    String?           @map("affiliate_partner_id") @db.Uuid
  affiliatePartner      AffiliatePartner? @relation(fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
  affiliatePayoutAmount Int?              @map("affiliate_payout_amount")

  photos            ProjectPhoto[]
  requirements      ProjectRequirements?
  designConcepts    DesignConcept[]
  quoteRequests     QuoteRequest[]
  activity          ActivityLog[]
  assistantMessages AssistantMessage[]
  transactions      Transaction[]
  privatePipelineSession PrivatePipelineSession?

  @@index([homeownerId])
  @@index([status])
  @@index([projectType])
  @@index([affiliatePartnerId])
  @@map("projects")
}

// ─────────────────────────────────────────────────────────────────────────
// Project photos
// ─────────────────────────────────────────────────────────────────────────

enum PhotoType {
  BEFORE
  INSPIRATION
  OTHER
}

model ProjectPhoto {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Supabase Storage object path (e.g. "project-photos/<project_id>/<uuid>.jpg"),
  // never a public URL and never binary data. Access is via short-lived
  // signed URLs generated server-side — see docs/BACKEND_ARCHITECTURE.md §6.
  storagePath String    @map("storage_path")
  photoType   PhotoType @default(BEFORE) @map("photo_type")
  uploadOrder Int       @default(0) @map("upload_order")
  // width, height, mime type, size in bytes — EXIF is stripped before storage.
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  designConcepts DesignConcept[]

  @@index([projectId])
  @@map("project_photos")
}

// ─────────────────────────────────────────────────────────────────────────
// Project requirements (flexible, per project type)
// ─────────────────────────────────────────────────────────────────────────

// One row per project. `data` holds project-type-specific answers as JSON,
// validated at the application layer against the field schema registered
// for that project type (src/lib/project-types.ts) rather than fixed
// columns — this is what lets Kitchen, Bathroom, Driveway, etc. each have
// a different question set without a table-per-type or a giant sparse
// table. This same record is the "structured project profile" that the
// GlowUpp AI assistant reads and updates in Phase 4 — the conversation
// itself is never the source of truth, this row is.
model ProjectRequirements {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_requirements")
}

// ─────────────────────────────────────────────────────────────────────────
// Assistant conversation (Phase 4)
// ─────────────────────────────────────────────────────────────────────────

// The transcript, kept for display/continuity — but it is explicitly NOT
// the source of truth for the project's brief. `ProjectRequirements.data`
// (and Project.budgetMin/budgetMax/targetStartDate) are; the assistant
// reads and writes those through the same validated path Phase 3's manual
// requirements form uses, never the other way around. Deliberately not
// exposed to professionals — see docs/BACKEND_ARCHITECTURE.md §16.
model AssistantMessage {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // "user" | "assistant" — a plain string rather than an enum, matching
  // ActivityLog's reasoning: room for e.g. a future "system" role without
  // a migration.
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("assistant_messages")
}

// ─────────────────────────────────────────────────────────────────────────
// Design concepts (AI-generated visuals)
// ─────────────────────────────────────────────────────────────────────────

enum DesignConceptStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

// Every generation is its own row and is never overwritten or updated in
// place (other than status/result as the async job progresses) — retrying
// or regenerating creates a new row with the next `version` number. This
// is what makes every design traceable back to its exact prompt, source
// photo, provider, and model.
model DesignConcept {
  id               String              @id @default(uuid()) @db.Uuid
  projectId        String              @map("project_id") @db.Uuid
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourcePhotoId    String              @map("source_photo_id") @db.Uuid
  sourcePhoto      ProjectPhoto        @relation(fields: [sourcePhotoId], references: [id])
  // Set once generation completes; null while pending/processing.
  storagePath      String?             @map("storage_path")
  generationPrompt String              @map("generation_prompt") @db.Text
  description      String?             @db.Text
  // Which entry of src/lib/design-styles.ts produced this concept — lets
  // "regenerate this style" reuse the same style modifier. Null for
  // concepts created via "request changes" (an edit of a prior concept,
  // not a fresh style application) or older pre-Phase-6 rows.
  styleKey         String?             @map("style_key")
  // Sequential per project (1, 2, 3, ...), assigned by the application at
  // creation time so the full history of a project's designs is orderable.
  version          Int
  status           DesignConceptStatus @default(PENDING)
  selectedByUser   Boolean             @default(false) @map("selected_by_user")
  provider         String
  model            String
  errorMessage     String?             @map("error_message") @db.Text
  createdAt        DateTime            @default(now()) @map("created_at")

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourcePhotoId])
  @@map("design_concepts")
}

// ─────────────────────────────────────────────────────────────────────────
// Professionals
// ─────────────────────────────────────────────────────────────────────────

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model Professional {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String              @map("business_name")
  description        String?             @db.Text
  postcode           String
  // UK postcode outward-code prefixes this professional serves, e.g.
  // ["L1", "L18"] or just ["L"] to cover an entire postcode area.
  // Matched via simple prefix comparison in src/lib/matching.ts —
  // deliberately not a numeric range parser (the brief's own example,
  // "L1-L25", is a range, but a prefix list covers the same real cases —
  // "serve one district" or "serve the whole area" — without needing
  // range-parsing logic for an MVP rule engine). serviceRadiusKm stays
  // below, unused by matching for now: proper geo-radius matching needs
  // postcode geocoding, deferred per docs/BACKEND_ARCHITECTURE.md.
  serviceAreaPrefixes String[]           @default([]) @map("service_area_prefixes")
  serviceRadiusKm    Int?                @map("service_radius_km")
  yearsExperience    Int?                @map("years_experience")
  verificationStatus VerificationStatus  @default(UNVERIFIED) @map("verification_status")
  // Optional, professional-initiated — not required to quote (see
  // docs/BACKEND_ARCHITECTURE.md). Uploading resets status to PENDING
  // for admin review regardless of prior status, so a re-upload (e.g.
  // renewed insurance) doesn't leave a stale VERIFIED badge unreviewed.
  verificationDocumentPath String?        @map("verification_document_path")
  verificationSubmittedAt  DateTime?      @map("verification_submitted_at")
  isAvailable        Boolean             @default(true) @map("is_available")
  // Short code for the contractor's private client link (/q/<code>).
  // Nullable so existing professionals need no backfill — it is minted
  // lazily the first time they open the pipeline page
  // (ensureReferralCodes in src/lib/data/private-pipeline.ts).
  referralCode             String?            @unique @map("referral_code")
  // Human-readable slug for the van-decal/yard-sign URL
  // (/pro/<slug>/quote). Same lazy minting as referralCode.
  vanQrSlug                String?            @unique @map("van_qr_slug")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  portfolioPhotos ProfessionalPortfolioPhoto[]
  services      ProfessionalService[]
  quoteRequests QuoteRequest[]
  transactions  Transaction[]
  privatePipelineSessions PrivatePipelineSession[]

  @@map("professionals")
}

// A small photo gallery of past work — unlike ProjectPhoto/verification
// documents, these are shown to homeowners upfront (on the quote detail
// page, not the quotes list, to keep that page's load light) rather
// than gated behind selection: the whole point of a portfolio is to
// influence the choice, unlike an address which has no reason to be
// seen before someone's committed.
model ProfessionalPortfolioPhoto {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  storagePath    String       @map("storage_path")
  uploadOrder    Int          @default(0) @map("upload_order")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([professionalId])
  @@map("professional_portfolio_photos")
}

// Which project types (Kitchen, Bathroom, ...) a professional offers.
// Values are validated against the same project-type registry as
// `Project.projectType`. This is the primary input to Phase 7's matching
// service.
model ProfessionalService {
  id             String       @id @default(uuid()) @db.Uuid
  professionalId String       @map("professional_id") @db.Uuid
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  projectType    String       @map("project_type")

  @@unique([professionalId, projectType])
  @@index([professionalId])
  @@map("professional_services")
}

// ─────────────────────────────────────────────────────────────────────────
// Quote requests
// ─────────────────────────────────────────────────────────────────────────

// A single status field covers the request/quote lifecycle end to end —
// the brief lists "request status" and "quote status" as separate fields,
// but they describe the same lifecycle from two angles, so one enum keeps
// the state machine unambiguous instead of allowing contradictory
// combinations (e.g. request "declined" but quote "submitted").
enum QuoteRequestStatus {
  PENDING // sent to the professional, awaiting a response
  VIEWED // professional has opened it
  DECLINED // professional passed on the opportunity
  QUOTED // professional submitted a quote
  EXPIRED // no response within the window
}

model QuoteRequest {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @map("project_id") @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  homeownerId    String              @map("homeowner_id") @db.Uuid
  homeowner      User                @relation("HomeownerQuoteRequests", fields: [homeownerId], references: [id])
  professionalId String              @map("professional_id") @db.Uuid
  professional   Professional        @relation(fields: [professionalId], references: [id])
  status         QuoteRequestStatus  @default(PENDING)
  message        String?             @db.Text
  sentAt         DateTime            @default(now()) @map("sent_at")
  viewedAt       DateTime?           @map("viewed_at")
  respondedAt    DateTime?           @map("responded_at")
  // Quote amount in pence, mirroring Project.budgetMin/Max.
  quoteAmount    Int?                @map("quote_amount")
  quoteTimeline  String?             @map("quote_timeline")
  quoteNotes     String?             @map("quote_notes") @db.Text
  // Itemised breakdown for private-pipeline quotes: an array of
  // { description: string, amountPence: number }. quoteAmount is always
  // the sum of these when present. Null for open-market quotes.
  quoteLineItems     Json?              @map("quote_line_items")
  // Deposit the professional asks the homeowner to pay DIRECTLY to them.
  // Recorded only — GlowUpp never processes or holds homeowner→
  // professional money (see Transaction's comment and
  // docs/BACKEND_ARCHITECTURE.md §23).
  depositAmount      Int?               @map("deposit_amount")
  depositRequestedAt DateTime?          @map("deposit_requested_at")
  depositReceivedAt  DateTime?          @map("deposit_received_at")
  // Mirrors DesignConcept.selectedByUser — only one quote request per
  // project should be selected at a time (enforced in the action, not a
  // DB constraint, same pattern as design selection in Phase 6).
  selected       Boolean             @default(false)
  messages       Message[]
  transaction    Transaction?

  @@index([projectId])
  @@index([professionalId])
  @@index([homeownerId])
  @@map("quote_requests")
}

// ─────────────────────────────────────────────────────────────────────────
// Messages
// ─────────────────────────────────────────────────────────────────────────

// One thread per QuoteRequest — a project-scoped conversation between the
// homeowner and one specific professional, not a general project-wide
// group chat (a project can have several QuoteRequests, each with its own
// thread, once quotes have gone out to more than one professional). Kept
// deliberately simple per the brief: a flat, ordered list of plain-text
// messages, no read receipts, no attachments, no editing/deleting.
model Message {
  id             String       @id @default(uuid()) @db.Uuid
  quoteRequestId String       @map("quote_request_id") @db.Uuid
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id") @db.Uuid
  sender         User         @relation(fields: [senderId], references: [id])
  body           String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([quoteRequestId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────
// Transactions (Phase 11 — design only, no real payment processing)
// ─────────────────────────────────────────────────────────────────────────

// Records a GlowUpp lead fee owed by a professional once they're
// selected for a job — NOT a homeowner payment. The chosen business
// model (confirmed with the product owner before building this) is
// lead-fee, not platform-mediated escrow: GlowUpp never touches
// homeowner→professional money at all, which keeps the MVP outside UK
// e-money/FCA regulatory territory (see docs/BACKEND_ARCHITECTURE.md
// §23 for the full reasoning and what's deliberately NOT built —
// there is no real payment collection anywhere in this schema or code,
// per the phase's explicit "design only" scope).
enum TransactionStatus {
  PENDING // fee owed, not yet paid
  PAID // manually reconciled as paid (no live payment processor yet)
  WAIVED // manually waived, e.g. goodwill or a promo
  CANCELLED // selection was reversed before payment
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  // One transaction per winning selection — enforced by this being a
  // unique 1:1 relation, not just an index, since exactly one
  // QuoteRequest per project can ever be `selected: true` (Phase 8).
  quoteRequestId String            @unique @map("quote_request_id") @db.Uuid
  quoteRequest   QuoteRequest      @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  professionalId String            @map("professional_id") @db.Uuid
  professional   Professional      @relation(fields: [professionalId], references: [id])
  projectId      String            @map("project_id") @db.Uuid
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Fee amount in pence, same convention as QuoteRequest.quoteAmount —
  // computed once at creation time (src/lib/fees.ts) and frozen here,
  // not recalculated later even if the fee rate changes.
  feeAmount      Int               @map("fee_amount")
  status         TransactionStatus @default(PENDING)
  createdAt      DateTime          @default(now()) @map("created_at")
  paidAt         DateTime?         @map("paid_at")
  // Set once the professional starts a Stripe Checkout session for this
  // fee, and used by the webhook handler to find the right Transaction
  // row from the event payload. Unique so a stale/duplicate webhook
  // delivery can't be matched to the wrong transaction.
  stripeCheckoutSessionId String?  @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?  @unique @map("stripe_payment_intent_id")
  // Set once the 24h "pay within 24h or this is cancelled" notice goes
  // out (src/lib/lead-fee-reminders.ts) — stops it sending twice, and
  // gates the actual 48h auto-cancel (only cancels fees that got the
  // warning first).
  feeFinalNoticeSentAt    DateTime? @map("fee_final_notice_sent_at")

  @@index([professionalId])
  @@index([projectId])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────────────────
// Private client pipeline
// ─────────────────────────────────────────────────────────────────────────

enum PipelineLockStatus {
  ACTIVE // client is locked to this professional for this project
  EXPIRED // lock ended (professional released it, or expiresAt passed)
}

// Created the moment a visitor who arrived via a contractor's referral
// link/QR starts a project (src/lib/data/private-pipeline.ts). It is the
// source of truth for "this project belongs to a private 2-way pipeline
// between this homeowner and this professional". The homeowner is always
// a real users row — an anonymous visitor already gets an isGuest user
// (src/lib/guest.ts), and mergeGuestIntoUser re-points these rows when
// that guest signs up — so no separate anonymous-session id is needed.
model PrivatePipelineSession {
  id                  String             @id @default(uuid()) @db.Uuid
  professionalId      String             @map("professional_id") @db.Uuid
  professional        Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  homeownerId         String             @map("homeowner_id") @db.Uuid
  homeowner           User               @relation(fields: [homeownerId], references: [id], onDelete: Cascade)
  // One session per project: a project is in exactly one pipeline.
  projectId           String             @unique @map("project_id") @db.Uuid
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lockStatus          PipelineLockStatus @default(ACTIVE) @map("lock_status")
  // Set when the homeowner presses "Send render & request official
  // estimate" — until then the professional sees renders but no contact
  // or address details.
  estimateRequestedAt DateTime?          @map("estimate_requested_at")
  // Null = permanent lock.
  expiresAt           DateTime?          @map("expires_at")
  createdAt           DateTime           @default(now()) @map("created_at")

  @@index([professionalId, lockStatus])
  @@index([homeownerId])
  @@map("private_pipeline_sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// Activity log
// ─────────────────────────────────────────────────────────────────────────

// Deliberately schema-light: `type` is a free string (e.g.
// "project_created", "design_generated") rather than an enum, because new
// event types will be added throughout every later phase and none of them
// should require a migration.
model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  actorId   String?  @map("actor_id") @db.Uuid
  actor     User?    @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([actorId])
  @@index([type])
  @@map("activity_log")
}

// ─────────────────────────────────────────────────────────────────────────
// Launch waitlist
// ─────────────────────────────────────────────────────────────────────────

// Pre-launch email capture (src/app/launch), deliberately separate from
// User/signup — this is anonymous interest, not an account, and most
// visitors haven't decided homeowner vs. professional yet. `source`
// carries a `?source=` query param off the shared link (e.g.
// "instagram-launch-post") so signups can be traced back to which post
// drove them.
model WaitlistSignup {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_signups")
}

enum AffiliateCategory {
  CAFE
  GYM
  GARDEN_CENTER
  SALON
  TRADE_SUPPLIER
  INFLUENCER
  OTHER
}

enum AffiliateStatus {
  ACTIVE
  SUSPENDED
}

// A local business or influencer who promotes GlowUpp to homeowners
// through a personal link/QR (/a/[code]) and earns revenueShareRate (50%
// by default) of the lead fee GlowUpp collects on jobs those homeowners
// book. Not a User: partners never log in — admins run the whole program
// from /admin/affiliates. Money is in pence, like everywhere else.
model AffiliatePartner {
  id               String            @id @default(uuid()) @db.Uuid
  businessName     String            @map("business_name")
  contactName      String            @map("contact_name")
  // Stored lowercase and unique: one partner account per business email
  // (self-service sign-up at /partner/join relies on it).
  email            String            @unique
  phone            String?
  category         AffiliateCategory
  status           AffiliateStatus   @default(ACTIVE)
  // 8-char code from the same alphabet as professionals' referral codes
  // (src/lib/referral.ts) and a human-friendly slug. /a/[code] accepts
  // either; the printed QR uses the slug so the visible URL is readable.
  referralCode     String            @unique @map("referral_code")
  qrSlug           String            @unique @map("qr_slug")
  // Fraction of GlowUpp's collected fee the partner earns. 0.5000 = 50%.
  revenueShareRate Decimal           @default(0.5000) @map("revenue_share_rate") @db.Decimal(5, 4)
  // Lifetime earned and lifetime paid out; the balance still owed is
  // total - paid (derived in code, so the three can never disagree).
  // A reversed fee after payout can push the balance negative: a clawback.
  totalEarningsPence Int             @default(0) @map("total_earnings_pence")
  paidEarningsPence  Int             @default(0) @map("paid_earnings_pence")
  // Raw hits on /a/[code]. Includes bots and repeat scans, so treat as an
  // upper bound; "projects" and "conversions" are the real signal.
  clickCount       Int               @default(0) @map("click_count")
  // True when the business signed itself up at /partner/join rather than an
  // admin creating it — shown in the admin table so payouts to
  // self-registered partners can be vetted first. termsAcceptedAt records
  // the partner-terms checkbox.
  selfRegistered   Boolean           @default(false) @map("self_registered")
  termsAcceptedAt  DateTime?         @map("terms_accepted_at")
  // Which version of the partner terms (PARTNER_TERMS_VERSION) was accepted.
  termsVersion     String?           @map("terms_version")
  // Set once an admin has checked the business is genuine and has its bank
  // details. Nobody can be paid out before this (recordAffiliatePayout). A
  // partner an admin creates by hand is verified at creation; one that
  // signed itself up stays null until an admin verifies it.
  verifiedAt       DateTime?         @map("verified_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  projects Project[]
  payouts  AffiliatePayout[]
  loginTokens AffiliateLoginToken[]

  @@index([status])
  @@map("affiliate_partners")
}

// Append-only log of money actually sent to a partner (bank transfer etc.
// done outside this system), so the "paid" figure always has a paper trail.
model AffiliatePayout {
  id          String           @id @default(uuid()) @db.Uuid
  partnerId   String           @map("partner_id") @db.Uuid
  partner     AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amountPence Int              @map("amount_pence")
  note        String?
  paidById    String?          @map("paid_by_id") @db.Uuid
  paidBy      User?            @relation("AffiliatePayoutAdmin", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt      DateTime         @default(now()) @map("paid_at")

  @@index([partnerId])
  @@map("affiliate_payouts")
}

// A sign-in link for the partner dashboard (/partner/dashboard?token=…),
// emailed to the partner and then kept by their browser in an httpOnly
// cookie. Only the SHA-256 of the random token is stored, so a database
// leak does not leak working logins. A partner can hold several at once
// (phone and laptop), and asking for another never signs the others out —
// otherwise anyone who typed a partner's email into the public form could
// keep logging them out.
model AffiliateLoginToken {
  id        String           @id @default(uuid()) @db.Uuid
  partnerId String           @map("partner_id") @db.Uuid
  partner   AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([partnerId])
  @@map("affiliate_login_tokens")
}
